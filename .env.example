# =============================================================================
# E-Menu — Production Environment Variables
# Copy to .env and fill in values:  cp .env.example .env
# =============================================================================

# --- Core ---
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=.printo-menu.com,printo-menu.com,localhost,127.0.0.1,backend
EMENU_BASE_DOMAIN=printo-menu.com

# --- Database (PostgreSQL) ---
POSTGRES_DB=emenu
POSTGRES_USER=emenu
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://emenu:change-me-strong-password@db:5432/emenu
DATABASE_SSL_REQUIRE=False

# --- Security / HTTPS ---
SECURE_SSL_REDIRECT=False
CSRF_COOKIE_DOMAIN=.emenu.com
SESSION_COOKIE_DOMAIN=.emenu.com
CSRF_TRUSTED_ORIGINS=https://emenu.com,https://www.emenu.com
CORS_ALLOWED_ORIGINS=https://emenu.com,https://www.emenu.com
CORS_ALLOWED_ORIGIN_REGEXES=^https://[\w-]+\.emenu\.com$

# --- Email (SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@emenu.com
ADMIN_CONTACT_EMAIL=admin@emenu.com

# --- Gunicorn ---
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# --- Auth handoff (cross-subdomain login, seconds) ---
AUTH_HANDOFF_TTL_SECONDS=120

# --- Redis (WebSocket channel layer — required in production multi-worker) ---
REDIS_URL=redis://redis:6379/0

# --- Docker ports (host) ---
HTTP_PORT=80
HTTPS_PORT=443

# --- SSL / Certbot (for setup-ssl.sh) ---
CERTBOT_EMAIL=admin@emenu.com
CERTBOT_DOMAIN=emenu.com
